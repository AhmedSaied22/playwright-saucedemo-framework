{
  "name": "playwright-saucedemo-tests",
  "version": "1.0.0",
  "description": "UI test automation framework built with Playwright, TypeScript, POM, fixtures, and Allure reporting using SauceDemo.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/ui/auth/login.spec.ts",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:clean": "npm run results:clean && playwright test",
    "report:playwright": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "results:clean": "node ./scripts/clean-results.js"
  },
  "keywords": [
    "playwright",
    "automation-testing",
    "qa",
    "allure-report",
    "ui-testing",
    "typescript"
  ],
  "author": "Ahmed Saied",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.38.1",
    "allure-js-commons": "^3.6.0",
    "allure-playwright": "^3.6.0"
  }
}